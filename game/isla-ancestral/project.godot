; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="isla-ancestral"
run/main_scene="res://scenes/main_island.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
DialogueManager="*res://scripts/dialogos/dialogue_manager.gd"
GameSettings="*res://scripts/core/game_settings.gd"
ServiceRegistry="*res://scripts/core/service_registry.gd"
GameLogger="*res://scripts/logging/logger.gd"
AnalyticsDirector="*res://scripts/analytics/analytics_director.gd"
SaveManager="*res://scripts/saving/save_manager.gd"
TimeCalendar="*res://scripts/time/time_calendar.gd"
ItemDatabase="*res://scripts/data/item_database.gd"
EconomyManager="*res://scripts/economia/economy_manager.gd"
SoftlockGuard="*res://scripts/core/softlock_guard.gd"
ShopManager="*res://scripts/shops/shop_manager.gd"
Inventario="*res://scripts/inventario/inventario_service.gd"
Friendship="*res://scripts/friendship/friendship_service.gd"
GameTime="*res://scripts/time/game_clock.gd"
RelojHud="*res://scripts/clock/reloj_hud.gd"
Bootstrap="*res://scripts/core/bootstrap.gd"
UIManager="*res://scripts/ui/core/ui_manager.gd"
TooltipService="*res://scripts/ui/services/tooltip_service.gd"
NotificationService="*res://scripts/ui/services/notification_service.gd"
VillagerManager="*res://scripts/npc/villager_manager.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gdscript]

"#M111-ConfiguraciÃ³ndelinterycalidaddecÃ³digo#HabilitarlinterestÃ¡ticodeGDScriptformatter/indent/type"=1
formatter/indent/size=4
formatter/indent/continuation=4
formatter/indent/preprocessor=1
formatter/space/around_operator=true
formatter/space/after_comma=true
formatter/space/before_brace=true
formatter/space/around_assignment=true
formatter/space/around_colon=true
formatter/space/inside_paren=false
formatter/space/inside_bracket=false
formatter/space/inside_brace=false
formatter/new_line/after_brace=true
formatter/new_line/before_brace=true
formatter/new_line/after_colon=false
formatter/new_line/after_comma=true
formatter/new_line/before_while=true
formatter/trailing_comma/arrays=true
formatter/trailing_comma/dictionaries=true
formatter/trailing_comma/enums=true
formatter/trailing_comma/parameter_lists=true
formatter/trailing_comma/argument_lists=true
formatter/quote/type=0
formatter/escape_sequence/strings=true
formatter/escape_sequence/chars=true
linter/enable=true
linter/warnings=PackedStringArray("unused_variable", "unused_parameter", "unused_signal", "unused_function", "unused_class", "unused_constant", "unused_enum", "shadowed_variable", "shadowed_parameter", "shadowed_function", "standalone_expression", "void_return_value", "return_value_discarded", "narrowing_conversion", "narrowing_conversion_implicit", "deprecated_keyword", "deprecated_builtin", "deprecated_property", "unsafe_method_access", "unsafe_property_access", "unsafe_operator", "cyclic_reference", "constant_used_as_function", "integer_division", "division_by_zero", "property_not_found", "method_not_found", "signal_not_found", "constant_not_found", "enum_not_found", "class_not_found", "resource_not_found", "file_not_found", "invalid_escape_sequence", "invalid_unicode_escape", "invalid_hex_escape", "invalid_string_format", "missing_await", "unhandled_error", "unhandled_error_return_value", "function_may_fail", "coroutine_not_awaited", "coroutine_yielded_without_await", "await_non_coroutine", "yield_non_generator", "break_outside_loop", "continue_outside_loop", "return_outside_function", "yield_outside_generator", "await_outside_coroutine", "super_not_called", "super_called_multiple_times", "abstract_method_not_implemented", "virtual_method_not_overridden", "signal_connection_failed", "signal_emission_failed", "property_set_failed", "property_get_failed", "method_call_failed", "constructor_failed", "destructor_failed", "initialization_failed", "cleanup_failed", "memory_leak", "null_reference", "out_of_bounds", "division_by_zero", "stack_overflow", "invalid_operation", "unsupported_operation", "not_implemented", "deprecated", "experimental", "performance_warning", "security_warning", "accessibility_warning", "internationalization_warning", "compatibility_warning", "portability_warning", "maintainability_warning", "readability_warning", "style_warning", "naming_warning", "documentation_warning", "testing_warning", "build_warning", "deployment_warning", "runtime_warning", "editor_warning", "export_warning", "import_warning", "plugin_warning", "addon_warning", "tool_warning", "script_warning", "scene_warning", "resource_warning", "node_warning", "input_warning", "output_warning", "network_warning", "physics_warning", "animation_warning", "audio_warning", "video_warning", "shader_warning", "material_warning", "texture_warning", "mesh_warning", "skeleton_warning", "skin_warning", "particle_warning", "navigation_warning", "ai_warning", "multiplayer_warning", "save_warning", "load_warning", "serialization_warning", "deserialization_warning", "encryption_warning", "compression_warning", "checksum_warning", "validation_warning", "sanitization_warning", "escaping_warning", "encoding_warning", "decoding_warning", "parsing_warning", "formatting_warning", "rendering_warning", "lighting_warning", "shadow_warning", "reflection_warning", "refraction_warning", "gi_warning", "ssao_warning", "ssr_warning", "bloom_warning", "dof_warning", "motion_blur_warning", "taa_warning", "fxaa_warning", "msaa_warning", "vsync_warning", "fullscreen_warning", "resolution_warning", "aspect_ratio_warning", "fov_warning", "near_far_warning", "exposure_warning", "white_balance_warning", "color_grading_warning", "tone_mapping_warning", "gamma_warning", "hdr_warning", "srgb_warning", "linear_warning", "log_warning", "exp_warning", "pow_warning", "sqrt_warning", "sin_warning", "cos_warning", "tan_warning", "asin_warning", "acos_warning", "atan_warning", "atan2_warning", "sinh_warning", "cosh_warning", "tanh_warning", "asinh_warning", "acosh_warning", "atanh_warning", "log2_warning", "log10_warning", "exp2_warning", "expm1_warning", "log1p_warning", "cbrt_warning", "hypot_warning", "erf_warning", "erfc_warning", "tgamma_warning", "lgamma_warning", "ceil_warning", "floor_warning", "round_warning", "trunc_warning", "fmod_warning", "remainder_warning", "copysign_warning", "nextafter_warning", "fdim_warning", "fmax_warning", "fmin_warning", "fma_warning", "lerp_warning",