# Godot 4+ specific ignores
.godot/
*.import
# export_presets.cfg NO se ignora (fix atria-dawn-s2 2026-10-04, Log 1287):
# los validadores M116/M117 lo leen en CI (4 presets: Web, Windows, ...).
# El .gitignore estandar de Godot lo excluye, pero este proyecto lo necesita
# versionado para que el pipeline de distribucion sea coherente.
*.translation

# Mono/C# ignores
.mono/
data_*/
mono_crash.*.json

# Android
/android/

# OS-specific
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Temp files (JetBrains, editors)
*.TMP
~$*

# Builds
/builds/
/export/

# GDSkills agent vision scratch (do not commit)
.gdskills/

# GDExtension binaries (instalar desde Godot Asset Library, no versionar)
# Excepcion: el addon voxel SI se versiona con sus binarios (decision del fundador,
# Log 1306). Sin el .so de Linux, el linter y las suites voxel-dependientes no
# compilan en CI (cascada voxel, diagnosticado en el frente de CI).
addons/*/bin/
!addons/zylann.voxel/bin/

# Godot executable (instalar localmente, no versionar)
/Godot/
/Godot_v*.exe
Godot_*.exe
