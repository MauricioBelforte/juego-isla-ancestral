[gd_resource type="Resource" load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/eventos/event_definition.gd" id="1_evdef"]
[ext_resource type="Script" path="res://scripts/eventos/recompensa_def.gd" id="2_recomp"]

[resource]
script = ExtResource("1_evdef")
id = "concurso_minero"
tipo = 2
nombre_clave = &"concurso_minero_nombre"
descripcion_clave = &"concurso_minero_desc"
