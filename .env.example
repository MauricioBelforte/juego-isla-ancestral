# ─────────────────────────────────────────────────────────────────────────────
# M106 Seguridad — Plantilla de variables de entorno (SIN secrets)
# ─────────────────────────────────────────────────────────────────────────────
# Este archivo SÍ se versiona: NO lleva valores reales, sólo placeholders vacíos.
# Para desarrollar: copiar a `.env.local` y completar. `.env.local` está en
# .gitignore y NUNCA se versiona (ver .gitignore L212-220).
#
# Carga: el juego lee las variables del proceso al inicio (M106) o las inyecta el CI.
# Regla T-006/RF2: ningún secret real en el código fuente — todo por entorno.
# ─────────────────────────────────────────────────────────────────────────────

# Entorno activo (dev | staging | prod). Ver data/security/security_environments.json.
APP_ENV=dev

# URL base de la API del entorno (vacío = usar el default del entorno).
API_BASE_URL=

# ── Claves por entorno (placeholders vacíos) ─────────────────────────────────
# Reemplazar SÓLO en `.env.local` (dev) o en el entorno del sistema (staging/prod).
API_KEY=
STEAM_API_KEY=
ANALYTICS_KEY=
CRASH_REPORTING_KEY=
TAMPER_SECRET_KEY=

# ── Telemetría / crash reporting (opt-in) ────────────────────────────────────
TELEMETRY_ENABLED=false
CRASH_REPORTING_ENABLED=false

# ── Logging ──────────────────────────────────────────────────────────────────
# Nivel de log: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO
