# ─────────────────────────────────────────────
# Isla Ancestral — .gitignore (Godot 4.x)
# ─────────────────────────────────────────────

# =============================================
# Godot — Archivos generados
# =============================================
.godot/
*.import
*.translation

# Godot — metadatos de import sueltos
*.uid

# Godot — addons (se instalan via AssetLib, no se versionan)
game/isla-ancestral/addons/

# =============================================
# Builds
# =============================================
build/
Builds/

# =============================================
# IDE / Editor
# =============================================
.vs/
.vscode/
.idea/
*.csproj
*.sln
*.suo
*.user
*.userprefs

# =============================================
# Sistema operativo
# =============================================
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.tmp
.DS_Store

# =============================================
# Python (scripts de automatización)
# =============================================
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# =============================================
# Node.js (MCP servers)
# =============================================
node_modules/

# =============================================
# Blender — backups del editor
# =============================================
*.blend1

# =============================================
# Agentes y configuraciones locales
# =============================================
.agents/
.kilo/
.gdskills/
.workbuddy-ai/
.claude/
.pre-commit-config.yaml

# =============================================
# Capturas de pantalla (no versionar)
# =============================================
**/capturas/

# =============================================
# Herramientas MCP — repos embebidos
# =============================================
tools/mcp/godot-mcp/
tools/mcp/.venv/

# =============================================
# Respaldos y temporales
# =============================================
*.bak-*
Obsoletos/
scripts/backups/
validate_*.bat

# =============================================
# Archivos sueltos de raíz (temporales de agentes)
# =============================================
_capture_tier_c.py
_fix_piramide2.py
_fix_spawn_pradera.py
fix_test_l71.py
check_godot.bat
run_m105.ps1
_gen_aprobado.gd
_gen_ideal.gd
_main_aprobado.gd
isla-modelo.jpg
isla-modelo-2.jpg
isla-modelo-3.jpg
paleta-propuesta-isla.png
docs/
.github/
tmp_*.py
tmp_*.txt
corregir_logs.py
analizar_logs.py
recover_estado*.py
patch_m74*.py
mark_m74_checklist.py
revert_m74.py
renombrar_logs.py
renombrados_logs.json
tmp_orig_guide.md
tmp_orig_s6.txt
fix_*.py
verify_*.py
gen_*.py

# =============================================
# Assets pesados de Blender (usar Git LFS si se necesitan)
# =============================================
*.blend

# =============================================
# EXCEPCIONES — carpetas que SÍ se versionan
# =============================================
!Logs/
!Obsoletos/
!DOCUMENTACION/
