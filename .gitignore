# ─────────────────────────────────────────────
# Isla Ancestral — .gitignore (proyecto Unity)
# Base: gitignore oficial de Unity (github/gitignore)
# Adaptado: la carpeta Logs/ de la raíz se VERSIONA
# (contiene los logs del protocolo de documentación)
# ─────────────────────────────────────────────

# =============================================
# Unity — Archivos generados
# =============================================
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Ss]creenshots/
/UIElementsSchema/

# Logs de Unity dentro de Assets (compilación/editor)
/Assets/**/[Ll]ogs/
/Assets/**/[Ll]og.txt

# Crash reports de Unity (runtime)
/[Cc]rash[Rr]eport[Ii]nfo/
/[Cc]rash[Rr]eport/

# Accelerator / licencias locales
/[Aa]ccelerator/[Ll]ogs/

# =============================================
# Unity — Plataformas (si se agregan builds específicos)
# =============================================
# iOS
/*.apk
/*.aab
/*.unitypackage
/*.app

# Android
[Aa]ndroid/AssetsPlugins/

# =============================================
# Visual Studio / IDE
# =============================================
.vs/
.vscode/
.idea/
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Rider / ReSharper
.settings/
.solution/
*.resharper

# =============================================
# Sistema operativo
# =============================================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.tmp

# macOS
.DS_Store
.AppleDouble
.LSOverride

# =============================================
# Control de versiones de terceros
# =============================================
*.lfs
LFS/

# =============================================
# Paquetes locales / cachés (no versionables)
# =============================================
/Packages/packages-lock.json.bak
*.pidb.meta

# =============================================
# HERAMIENTAS DEL PROTOCOLO — respaldos generados
# Los backups automáticos de scripts/ NO se versionan
# =============================================
/scripts/backups/

# =============================================
# Agentes y configuraciones locales
# =============================================
.agents/

# =============================================
# Respaldos y scripts temporales
# =============================================
*.bak-*
validate_*.bat

# =============================================
# Python (scripts de automatización)
# =============================================
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# =============================================
# Capturas del protocolo de visión (no versionables)
# Se guardan TODAS en disco durante el desarrollo, pero fuera de git
# =============================================
**/capturas/

# =============================================
# EXCEPCIONES — Carpetas del proyecto que SÍ se versionan
# =============================================
!Logs/
!Obsoletos/
!DOCUMENTACION/
# Builds web export (generados, no versionar)
build/

# =============================================
# Repositorios embebidos (usar submodule si se necesita)
# =============================================
tools/mcp/godot-mcp/

# =============================================
# Blender - backups automaticos del editor
# Blender genera .blend1 en cada guardado
# (backup de la version anterior del .blend)
# =============================================
*.blend1

# =============================================
# Estado local de herramientas de agentes
# =============================================
.workbuddy-ai/

# =============================================
# Godot — dependencias de terceros (addons)
# gdUnit4 es un framework de tests externo (~160 MB); se instala via
# AssetLib / addons manager, no se versiona. Usar submodule si se quiere pin.
# =============================================
game/isla-ancestral/addons/

# =============================================
# Godot — metadatos de import generados por el editor
# Los .uid se regeneran al importar; los sueltos en raiz son ruido.
# (los .uid dentro de scripts versionados se mantienen con el script)
# =============================================
*.uid

# =============================================
# Scripts sueltos / temporales en la raiz del repo
# Son archivos de trabajo del agente, no fuente del proyecto.
# =============================================
_capture_tier_c.py
_fix_piramide2.py
_fix_spawn_pradera.py
fix_test_l71.py
check_godot.bat
run_m105.ps1
_gen_aprobado.gd
_gen_ideal.gd
_main_aprobado.gd
isla-modelo-2.jpg
isla-modelo-3.jpg
isla-modelo.jpg
paleta-propuesta-isla.png
docs/
.github/

# =============================================
# Backups de Blender (ya cubierto arriba, refuerzo explicito)
# =============================================
*.blend1

# =============================================
# Configuracion local de agentes / hooks (no es fuente del proyecto)
# =============================================
.claude/
.pre-commit-config.yaml

# =============================================
# Probes temporales de colision generados durante QA
# =============================================
game/isla-ancestral/_probe_col.gd
game/isla-ancestral/_probe_col.gd.uid
game/isla-ancestral/_test_2x.gd.uid

