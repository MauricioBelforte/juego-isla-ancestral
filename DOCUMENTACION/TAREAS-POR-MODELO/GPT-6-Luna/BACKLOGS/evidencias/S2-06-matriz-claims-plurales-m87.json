        {
          "file": "game/isla-ancestral/scripts/localization/localization_manager.gd",
          "line": 151,
          "text": "if n != -1 and not params_final.has(\"n\"):"
        },
        {
          "file": "game/isla-ancestral/scripts/localization/localization_manager.gd",
