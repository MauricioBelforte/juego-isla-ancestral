          "text": "params_final[\"n\"] = n"
        },
        {
          "file": "game/isla-ancestral/scripts/localization/localization_manager.gd",
          "line": 153,
          "text": "var resuelto := format_text(texto, params_final)"
        },
        {
          "file": "game/isla-ancestral/scripts/localization/localization_manager.gd",
          "line": 154,
          "text": "_cache[cache_key] = resuelto"
        }
      ],
      "assessment": "corroborado_en_codigo_estatico",
      "notes": "_tr_clave copia params y añade n si n!=-1 y params no lo incluye; luego aplica format_text."
    },
